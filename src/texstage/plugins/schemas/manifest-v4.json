{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Texstage experimental plugin manifest 4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "version",
    "plugin_api",
    "description",
    "license",
    "capabilities",
    "resources"
  ],
  "properties": {
    "manifest_version": {
      "const": 4
    },
    "plugin_api": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "latex_namespace": {
      "type": "string",
      "pattern": "^[a-z]+$",
      "maxLength": 32
    },
    "latex_exports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "$ref": "#/$defs/exports"
        },
        "environments": {
          "$ref": "#/$defs/exports"
        }
      }
    },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 500,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "size"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 33554432
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "engines": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/engine"
          }
        },
        "content_types": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/content"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 160
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 80
    },
    "exports": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z]+$",
        "maxLength": 100
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_api",
        "module",
        "seed_types",
        "input",
        "canonical_format",
        "summary_kinds",
        "state_policy"
      ],
      "properties": {
        "engine_api": {
          "const": 1
        },
        "module": {
          "$ref": "#/$defs/path"
        },
        "assets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "seed_types": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^\\.[a-z0-9]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "label",
            "tokens"
          ],
          "properties": {
            "mode": {
              "const": "code"
            },
            "label": {
              "type": "string",
              "maxLength": 100
            },
            "tokens": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 50
              }
            }
          }
        },
        "canonical_format": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "maxLength": 80
        },
        "summary_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "select",
              "ask",
              "graph",
              "text"
            ]
          }
        },
        "state_policy": {
          "const": "fresh-per-submission"
        },
        "result_data_schema": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_api",
        "state_hook",
        "state_schema",
        "views",
        "fallback",
        "view_schemas"
      ],
      "properties": {
        "content_api": {
          "const": 1
        },
        "build_hook": {
          "$ref": "#/$defs/name"
        },
        "state_hook": {
          "$ref": "#/$defs/name"
        },
        "state_schema": {
          "type": "integer",
          "minimum": 1
        },
        "participant_updates": {
          "type": "string",
          "const": "actor"
        },
        "latex_packages": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "evaluations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "maxProperties": 16,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "engine"
            ],
            "properties": {
              "engine": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "views": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presenter-overlay",
            "projector-overlay"
          ],
          "properties": {
            "presenter-overlay": {
              "$ref": "#/$defs/path"
            },
            "presenter-controls": {
              "$ref": "#/$defs/path"
            },
            "projector-overlay": {
              "$ref": "#/$defs/path"
            },
            "participant-input": {
              "$ref": "#/$defs/path"
            }
          }
        },
        "messages": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "revision_policy",
              "schema"
            ],
            "properties": {
              "from": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "presenter",
                    "participant"
                  ]
                }
              },
              "revision_policy": {
                "enum": [
                  "exact",
                  "latest"
                ]
              },
              "schema": {
                "$ref": "#/$defs/path"
              },
              "record_actor_field": {
                "$ref": "#/$defs/name"
              }
            }
          }
        },
        "fallback": {
          "const": "static-slide"
        },
        "view_schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presenter-overlay",
            "projector-overlay"
          ],
          "properties": {
            "presenter-overlay": {
              "$ref": "#/$defs/path"
            },
            "presenter-controls": {
              "$ref": "#/$defs/path"
            },
            "projector-overlay": {
              "$ref": "#/$defs/path"
            },
            "participant-input": {
              "$ref": "#/$defs/path"
            }
          }
        },
        "authoring_hook": {
          "$ref": "#/$defs/name"
        },
        "actor_records": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capacity",
            "page_size",
            "page_field",
            "value_schema",
            "summary_schema"
          ],
          "properties": {
            "capacity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25
            },
            "page_field": {
              "$ref": "#/$defs/name"
            },
            "value_schema": {
              "$ref": "#/$defs/path"
            },
            "summary_schema": {
              "$ref": "#/$defs/path"
            }
          }
        },
        "scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "points_field"
          ],
          "properties": {
            "policy": {
              "const": "fixed-v1"
            },
            "points_field": {
              "$ref": "#/$defs/name"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "build_hook"
          ],
          "not": {
            "required": [
              "authoring_hook"
            ]
          }
        },
        {
          "required": [
            "authoring_hook"
          ],
          "not": {
            "required": [
              "build_hook"
            ]
          }
        }
      ]
    }
  }
}
