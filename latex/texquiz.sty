% ---------------------------------------------------------------- drawing
\def\texquiz@vfill{\vskip 0pt plus 1filll\relax}

% \texquiznotes, set by the build, is texstage.sty's.
% Kahoot-style answer identities: colour + shape (same order on the phones).
\definecolor{texquiz-1}{HTML}{E21B3C}% red triangle
\definecolor{texquiz-2}{HTML}{1368CE}% blue diamond
\definecolor{texquiz-3}{HTML}{D89E00}% yellow circle
\definecolor{texquiz-4}{HTML}{26890C}% green square
\definecolor{texquiz-5}{HTML}{864CBF}% purple star
\definecolor{texquiz-6}{HTML}{0AA3A3}% teal hexagon
\colorlet{texquiz-correct}{texquiz-4!80!black}
\colorlet{texquiz-panel}{black!5}
\colorlet{texquiz-hint}{black!60}

% \texquiz@shape{n}{r}: filled shape n of radius r centred at the origin.
\def\texquiz@shape#1#2{%
  \ifcase#1\relax
  \or \fill (90:#2) -- (210:#2) -- (330:#2) -- cycle;
  \or \fill (90:#2) -- (180:#2) -- (270:#2) -- (0:#2) -- cycle;
  \or \fill (0,0) circle ({0.8*#2});
  \or \fill ({-0.72*#2},{-0.72*#2}) rectangle ({0.72*#2},{0.72*#2});
  \or \fill (90:#2) -- (126:{0.42*#2}) -- (162:#2) -- (198:{0.42*#2}) -- (234:#2)
        -- (270:{0.42*#2}) -- (306:#2) -- (342:{0.42*#2}) -- (18:#2) -- (54:{0.42*#2}) -- cycle;
  \or \fill (0:#2) -- (60:#2) -- (120:#2) -- (180:#2) -- (240:#2) -- (300:#2) -- cycle;
  \fi}

% \texquizbadge{n}: shape n in its colour, inline (e.g. next to an answer letter).
\newcommand\texquizbadge[1]{%
  \tikz[baseline=-0.6ex]{%
    \fill[texquiz-#1, rounded corners=1pt] (-0.8ex,-0.8ex) rectangle (0.8ex,0.8ex);
    \begin{scope}[fill=white]\texquiz@shape{#1}{0.58ex}\end{scope}}}

% ---------------------------------------------------------------- theme hooks
% Redefine these (e.g. in texquiz-theme-dbis.sty) to change the look.  The
% geometry the live overlays need is recorded around them, so a theme only
% draws.
%
% \texquizprompt{text}          the question, in a box of the prompt's width
% \texquizchoice{label}{shape}{width}{height}{state}{content}
%     one answer box of exactly #3 x #4 (#4 empty: natural height), reference
%     point at its lower-left corner; label = A, B, ... (the rank in a revealed
%     ordering); shape = 1..6 (\texquizbadge); state = plain|correct|wrong.
%     Correct and wrong answers must look the same in state plain.
% \texquizchoicefont, \texquizchoiceoverhead, \texquizmaxcols
%     the answers' font, the width a box needs besides its text, and the most
%     answers in one row (used to choose the number of columns)
% \texquizexplanation{text}     the explanation on reveal/solution pages
% \texquizhint{text}            "Enter a number on your phone." etc.
\newcommand\texquizprompt[1]{{\large #1\par}}
\newcommand\texquizchoicefont{\normalsize}
\newcommand\texquizmaxcols{2}
% stripe 0.75cm + padding 2 x 0.13cm + 1.3cm kept free for the live counts
\newcommand\texquizchoiceoverhead{2.31cm}
\newsavebox\texquiz@cellbox
\newcommand\texquizchoice[6]{%
  \sbox\texquiz@cellbox{%
    \parbox{\dimexpr#3-\texquizchoiceoverhead\relax}{\raggedright\texquizchoicefont
      \texquiz@rank{#1}#6}}%
  \ifx\relax#4\relax
    \dimen@=\dimexpr\ht\texquiz@cellbox+\dp\texquiz@cellbox+0.26cm\relax
    \ifdim\dimen@<0.9cm \dimen@=0.9cm \fi
    \edef\texquiz@h{\the\dimen@}%
  \else
    \edef\texquiz@h{#4}%
  \fi
  \texquiz@kahootbox{#2}{#3}{\texquiz@h}{#5}{\usebox\texquiz@cellbox}}
% the shapes carry no letters: in a revealed ordering show the rank ("2.")
\newcommand\texquiz@rank[1]{\in@{#1}{123456}\ifin@\textbf{#1.}~\fi}
\newcommand\texquizexplanation[1]{%
  {\setlength\fboxsep{5pt}%
   \colorbox{texquiz-panel}{\parbox{\dimexpr\linewidth-2\fboxsep\relax}{\raggedright\small #1}}}}
\newcommand\texquizhint[1]{{\color{texquiz-hint}\small #1\par}}

% \texquiz@kahootbox{shape}{width}{height}{plain|correct|wrong}{content}
\newcommand\texquiz@kahootbox[5]{%
  \begin{tikzpicture}[baseline=0pt]
    \useasboundingbox (0,0) rectangle (#2,#3);
    \fill[texquiz-#1!9, rounded corners=3pt] (0,0) rectangle (#2,#3);
    \fill[texquiz-#1, rounded corners=3pt] (0,0) rectangle (0.75cm,#3);
    \fill[texquiz-#1] (0.6cm,0) rectangle (0.75cm,#3);
    \draw[texquiz-#1, line width=0.6pt, rounded corners=3pt] (0,0) rectangle (#2,#3);
    \begin{scope}[shift={(0.375cm,{0.5*#3})}, fill=white]
      \texquiz@shape{#1}{0.22cm}
    \end{scope}
    \node[anchor=west, inner sep=0pt] at (0.88cm,{0.5*#3}) {#5};
    \texquiz@state{#4}{#2}{#3}%
  \end{tikzpicture}}
\def\texquiz@state#1#2#3{%
  \ifnum\pdf@strcmp{#1}{correct}=0
    \draw[texquiz-correct, line width=2.2pt, rounded corners=3pt] (0,0) rectangle (#2,#3);
    \fill[texquiz-correct] (#2,#3) circle (0.22cm);
    \draw[white, line width=1.6pt, line cap=round, line join=round]
      ({#2-0.1cm},{#3}) -- ({#2-0.025cm},{#3-0.08cm}) -- ({#2+0.11cm},{#3+0.09cm});
  \fi
  \ifnum\pdf@strcmp{#1}{wrong}=0
    \fill[white, fill opacity=0.62, rounded corners=3pt] (0,0) rectangle (#2,#3);
  \fi}

\newcommand\texquiz@placeholder[2]{%
  \texquiz@vfill
  \begin{center}
    \begin{tikzpicture}
      \foreach \i in {1,...,4} {
        \fill[texquiz-\i, rounded corners=3pt] ({1.1*\i-0.45},-0.45) rectangle ({1.1*\i+0.45},0.45);
        \begin{scope}[shift={({1.1*\i},0)}, fill=white]\texquiz@shape{\i}{0.25cm}\end{scope}
      }
    \end{tikzpicture}\par\medskip
    {\Large\bfseries #1\par}\smallskip
    #2\par
  \end{center}
  \texquiz@vfill}

\newcommand\texquiz@join[2]{%
  \texquiz@vfill
  \begin{center}
    #1\par
    \ifx\relax#2\relax\else
      \medskip
      \@ifundefined{qrcode}{}{\qrcode[height=2.4cm]{#2}\par\smallskip}%
      {\large\texttt{\detokenize{#2}}\par}%
    \fi
  \end{center}
  \texquiz@vfill}

% ---------------------------------------------------------------- quiz and answer frames
% \begin{frame}[quiz]{Question: ...}    a frame of the author's that contains a
%     quiz environment (with material around it).
% \begin{frame}[answer]{Answer: ...}  an ordinary frame that gives away the
%     answer to a question asked earlier.
% In the handout both become a placeholder page with a neutral title (titles
% like "The Answer Is C" would tell); in the other modes they are shown as
% written.  Still one page per frame.
%
% Every frame body, a fragile one after its round trip through the .vrb file,
% is typeset by \beamer@doseveralframes{<body>}.  For such a frame in the
% handout that body is run in a box that is thrown away - with \label recorded
% and set again on the placeholder, so references to the frame still resolve,
% and quizzes still checked - and the placeholder is typeset instead.
\newif\iftexquiz@quizframe
\define@key{beamerframe}{quiz}[true]{%
  \ifnum\pdf@strcmp{#1}{true}=0
    \texquiz@quizframetrue
    \texquiz@ifhandout{%
      \def\texquiz@ph@title{\texquiz@quiztitle}%
      \def\texquiz@ph@heading{\texquiz@handoutheading}%
      \def\texquiz@ph@text{\texquiz@handouttext}%
      \let\beamer@doseveralframes\texquiz@placeholder@frames}{}%
  \fi}
% answer=<quiz id> also tells the live deck that this frame reveals that quiz
% (with reveal=none): the builder puts the add-in on it, which closes and
% scores the question.
\define@key{beamerframe}{answer}[true]{%
  \ifnum\pdf@strcmp{#1}{false}=0 \else
    \texquiz@ifhandout{%
      \def\texquiz@ph@title{\texquiz@answertitle}%
      \def\texquiz@ph@heading{\texquiz@answerheading}%
      \def\texquiz@ph@text{\texquiz@answertext}%
      \let\beamer@doseveralframes\texquiz@placeholder@frames}{%
      \ifnum\pdf@strcmp{#1}{true}=0
        \let\texquiz@answerid\@empty
      \else
        \def\texquiz@answerid{#1}%
      \fi
      \let\beamer@doseveralframes\texquiz@answerrecord@frames}%
  \fi}
% the record goes after the body, so Beamer still finds a {title} at its start
\long\def\texquiz@answerrecord@frames#1{%
  \global\let\beamer@doseveralframes\texquiz@orig@doseveralframes
  \texquiz@orig@doseveralframes{#1\texquiz@answermark}}
\def\texquiz@answermark{%
  \texquiz@checkmark{answer}{\texquiz@answerid}%
  \ifx\texquiz@answerid\@empty\else
    \texquiz@pagerecord{answer}{\texquiz@answerid}{answer}%
  \fi}
\let\texquiz@orig@doseveralframes\beamer@doseveralframes
\long\def\texquiz@placeholder@frames#1{%
  \global\let\beamer@doseveralframes\texquiz@orig@doseveralframes
  \texquiz@orig@doseveralframes{\texquiz@placeholder@body#1\texquiz@placeholder@end}}
\long\def\texquiz@placeholder@body#1\texquiz@placeholder@end{%
  \global\let\texquiz@ph@labels\@empty
  \setbox\z@\vbox{%
    \let\label\texquiz@ph@label
    \let\frametitle\texquiz@ph@gobbletitle
    \let\framesubtitle\texquiz@ph@gobbletitle
    #1}%
  \global\beamer@anotherslidefalse
  \frametitle{\texquiz@ph@title}%
  \texquiz@ph@labels
  \texquiz@placeholder{\texquiz@ph@heading}{\texquiz@ph@text}}
\NewDocumentCommand\texquiz@ph@label{d<> m}{\g@addto@macro\texquiz@ph@labels{\label{#2}}}
\NewDocumentCommand\texquiz@ph@gobbletitle{d<> o m}{}

\endinput
