% ---------------------------------------------------------------- frames
\cs_new_protected:Npn \__tq_check_outside_frame:n #1
  {
    \legacy_if:nT { beamer@inframe }
      { \__tq_general_error:n { #1~must~not~be~used~inside~a~frame~(it~creates~frames). } }
  }
% A quiz is one frame in every mode (so frame numbers agree between the handout
% and the projector); in present mode that frame has three slides - reading
% (the question alone), question and reveal; two with reveal=none.  The
% lecturer's click from the reading slide to the question slide starts the
% round.  Leaderboards are not frames: the builder adds them.
%
%  * Between frames, `quiz` makes its own frame (built-in layout).
%  * Inside a frame with the option `quiz` (\begin{frame}[quiz]), it typesets
%    the question and the answer boxes in place, below the author's material
%    (figures, tables, listings - also in fragile frames).  In the handout the
%    whole frame is replaced by the placeholder (see "quiz and answer frames").
\cs_new_protected:Npn \__tq_quiz:nnn #1#2#3
  {
    \legacy_if:nTF { beamer@inframe }
      { \__tq_inline_quiz:nnn {#1} {#2} {#3} }
      { \__tq_frame_quiz:nnn {#1} {#2} {#3} }
  }
\cs_new_protected:Npn \__tq_declare:nnn #1#2#3
  {
    \__tq_reset:
    \keys_set:nn { texquiz / quiz } {#1}
    \regex_match:nVF { \A [a-z0-9] [a-z0-9-]{0,62} \Z } \g__tq_id_tl
      { \__tq_error:n { id~is~required~(lower-case~letters,~digits,~hyphens). } }
    % a frame body is typeset once per slide: register the id on the first one
    \int_compare:nNnT { \beamer@slideinframe } < { 2 }
      {
        \seq_if_in:NVT \g__tq_all_ids_seq \g__tq_id_tl
          { \__tq_error:n { duplicate~quiz~id. } }
        \seq_gput_right:NV \g__tq_all_ids_seq \g__tq_id_tl
      }
    \tl_if_blank:nT {#2} { \__tq_error:n { the~question~text~is~empty. } }
    \tl_gset:Nn \g__tq_prompt_tl {#2}
    \__tq_collect:n {#3}
    \__tq_infer_type:
    \__tq_validate:
    \__tq_compute_order:
  }
\cs_new_protected:Npn \__tq_frame_quiz:nnn #1#2#3
  {
    \__tq_declare:nnn {#1} {#2} {#3}
    \frame[t]
      {
        % the handout shows a neutral title: a quiz title may name the topic
        \__tq_if_mode:nTF { handout }
          { \frametitle { \g__tq_default_title_tl } }
          { \frametitle { \g__tq_title_tl } }
        \__tq_frame_body:nn { \c_true_bool } {#3}
        \__tq_render:n { frame }
      }
  }
\cs_new_protected:Npn \__tq_inline_quiz:nnn #1#2#3
  {
    \legacy_if:nF { texquiz@quizframe }
      {
        \__tq_general_error:n
          {
            a~quiz~inside~a~frame~needs~the~frame~option~'quiz',~e.g.~
            \iow_char:N\\begin \iow_char:N\{ frame \iow_char:N\} [t,quiz]
          }
      }
    \__tq_declare:nnn {#1} {#2} {#3}
    % the quiz's title (for the host console and results) is the frame's
    \bool_if:NF \g__tq_title_given_bool
      {
        \cs_if_exist:NT \beamer@frametitle
          { \tl_gset_eq:NN \g__tq_title_tl \beamer@frametitle }
      }
    \__tq_frame_body:nn { \c_true_bool } {#3}
    \__tq_render:n { inline }
  }
% #1 = frame | inline
\cs_new_protected:Npn \__tq_render:n #1
  {
    \__tq_check_mark:nn { quiz } { \g__tq_id_tl }
    \str_case:Vn \g_texstage_mode_str
      {
        { handout }
          {
            % an inline quiz in the handout only runs inside the box that the
            % `quiz` frame option throws away
            \str_if_eq:nnT {#1} { frame }
              { \texquiz@placeholder { \g__tq_handout_heading_tl } { \g__tq_handout_text_tl } }
          }
        { solutions } { \__tq_layout:nn { solution } {#1} }
        { present }
          {
            % slides: reading (the question, its answers not yet shown), question
            % (showing it starts the round) and, unless reveal=none, the reveal
            \str_if_eq:VnTF \g__tq_reveal_tl { none }
              { \only<2>{} }
              { \only<3>{} }
            \int_case:nnF { \beamer@slideinframe }
              {
                { 1 }
                  {
                    \__tq_export:
                    \__tq_page_record:nnn { quiz } { \g__tq_id_tl } { read }
                    \__tq_layout:nn { read } {#1}
                    \__tq_make_assets:
                  }
                { 2 }
                  {
                    \__tq_page_record:nnn { quiz } { \g__tq_id_tl } { question }
                    \__tq_layout:nn { question } {#1}
                  }
              }
              {
                \__tq_page_record:nnn { quiz } { \g__tq_id_tl } { reveal }
                \__tq_layout:nn { reveal } {#1}
              }
          }
      }
  }
\NewDocumentEnvironment { quiz } { O{} m +b } { \__tq_quiz:nnn {#1} {#2} {#3} } { }

% Frames whose content is drawn live by the add-in.
\cs_new_protected:Npn \__tq_live_frame:nnn #1#2#3 % kind/phase, id, title
  {
    \frame[t]
      {
        \frametitle {#3}
        \__tq_page_record:nnn {#1} {#2} {#1}
        \__tq_vmark:nnn {#2} {#1} { live-top }
        \__tq_vfill:
        \__tq_vmark:nnn {#2} {#1} { live-bottom }
        \__tq_frame_note:
      }
  }
% The join, leaderboard and podium frames take [title=..., note={...}]: note is the
% frame's speaker note (paragraphs allowed), shown wherever Beamer shows notes and in
% the live deck's PowerPoint notes - these frames have no body to write \note into.
\tl_new:N \l__tq_frame_note_tl
\keys_define:nn { texquiz / frame }
  {
    title .tl_set:N = \l__tq_tmp_tl ,
    note .tl_set:N = \l__tq_frame_note_tl ,
    unknown .code:n = \__tq_general_error:n { unknown~key~'\l_keys_key_str'. }
  }
\cs_new_protected:Npn \__tq_frame_note:
  { \tl_if_empty:NF \l__tq_frame_note_tl { \exp_args:NV \note \l__tq_frame_note_tl } }
\NewDocumentCommand \quizjoinframe { +O{} }
  {
    \__tq_check_outside_frame:n { \iow_char:N\\quizjoinframe }
    \group_begin:
      \tl_set_eq:NN \l__tq_tmp_tl \g__tq_join_title_tl
      \keys_set:nn { texquiz / frame } {#1}
      \__tq_if_mode:nTF { present }
        { \__tq_live_frame:nnn { join } { } { \l__tq_tmp_tl } }
        {
          \frame[t]
            {
              \frametitle { \l__tq_tmp_tl }
              \exp_args:NVV \texquiz@join \g__tq_join_text_tl \g__tq_join_url_tl
              \__tq_frame_note:
            }
        }
    \group_end:
  }
\cs_new_protected:Npn \__tq_results_frame:nnn #1#2#3 % kind, default title, options
  {
    \group_begin:
      \tl_set_eq:NN \l__tq_tmp_tl #2
      \keys_set:nn { texquiz / frame } {#3}
      \__tq_if_mode:nTF { present }
        { \__tq_live_frame:nnn {#1} { } { \l__tq_tmp_tl } }
        {
          \frame[t]
            {
              \frametitle { \l__tq_tmp_tl }
              \texquiz@placeholder { \l__tq_tmp_tl } { \g__tq_results_text_tl }
              \__tq_frame_note:
            }
        }
    \group_end:
  }
\NewDocumentCommand \quizleaderboardframe { +O{} }
  {
    \__tq_check_outside_frame:n { \iow_char:N\\quizleaderboardframe }
    \__tq_results_frame:nnn { leaderboard } \g__tq_leaderboard_title_tl {#1}
  }
\NewDocumentCommand \quizpodiumframe { +O{} }
  {
    \__tq_check_outside_frame:n { \iow_char:N\\quizpodiumframe }
    \__tq_results_frame:nnn { podium } \g__tq_podium_title_tl {#1}
  }
