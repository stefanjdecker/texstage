% ---------------------------------------------------------------- body commands
% While collecting (dry pass, outside any frame) \choice and friends record the
% question; inside the generated frames they are no-ops, so the same body can be
% executed again for its \note and \label.
\NewDocumentCommand \__tq_collect_choice:w { s O{} +m }
  {
    \tl_clear:N \l__tq_choice_id_tl
    \keys_set:nn { texquiz / choice } {#2}
    \tl_if_blank:nT {#3} { \__tq_error:n { empty~\iow_char:N\\choice. } }
    \seq_gput_right:Nn \g__tq_choice_seq {#3}
    \tl_if_empty:NT \l__tq_choice_id_tl
      { \tl_set:Ne \l__tq_choice_id_tl { \int_to_Alph:n { \seq_count:N \g__tq_choice_seq } } }
    \regex_match:nVF { \A [A-Za-z0-9-]{1,32} \Z } \l__tq_choice_id_tl
      { \__tq_error:n { invalid~choice~id~'\l__tq_choice_id_tl'. } }
    \seq_if_in:NVT \g__tq_choice_id_seq \l__tq_choice_id_tl
      { \__tq_error:n { duplicate~choice~id~'\l__tq_choice_id_tl'. } }
    \seq_gput_right:NV \g__tq_choice_id_seq \l__tq_choice_id_tl
    \IfBooleanTF {#1}
      { \seq_gput_right:Nn \g__tq_correct_seq { 1 } }
      { \seq_gput_right:Nn \g__tq_correct_seq { 0 } }
  }
\NewDocumentCommand \__tq_collect_explain:w { +m }
  {
    \bool_if:NT \g__tq_explain_bool { \__tq_error:n { more~than~one~\iow_char:N\\explain. } }
    \bool_gset_true:N \g__tq_explain_bool
    \tl_gset:Nn \g__tq_explain_tl {#1}
  }
\NewDocumentCommand \__tq_collect_accept:w { m }
  {
    \tl_if_blank:nT {#1} { \__tq_error:n { empty~\iow_char:N\\accept. } }
    \seq_gput_right:Nn \g__tq_accept_seq {#1}
    \__tq_accept_text:n {#1}
  }
% A phone sends the displayed text, not its LaTeX source. Hyperref's Unicode
% PDF-string conversion handles accents, escaped punctuation, ties and text
% formatting. Do not silently remove unsupported commands: the author can use
% \texorpdfstring{display}{plain answer}, as for a PDF bookmark.
\cs_new_protected:Npn \__tq_accept_text:n #1
  {
    \group_begin:
      \hypersetup { pdfencoding=unicode }
      \cs_set_protected:Npn \HyPsd@Warning ##1
        {
          \__tq_error:n
            { accepted~text~cannot~be~converted~to~plain~text;~use~
              \iow_char:N\\texorpdfstring~with~a~plain-text~second~argument. }
        }
      \pdfstringdef \l__tq_accept_pdf_tl {#1}
      \EdefUnescapeString \l__tq_accept_bytes_tl { \l__tq_accept_pdf_tl }
      \exp_args:NNV \str_set_convert:Nnnn \l__tq_accept_str \l__tq_accept_bytes_tl
        { utf16 } { utf8 }
      \tl_if_blank:VT \l__tq_accept_str
        { \__tq_error:n { accepted~plain~text~must~not~be~empty. } }
      \seq_gput_right:Ne \g__tq_accept_hex_seq { \__tq_hex:V \l__tq_accept_str }
    \group_end:
  }
\NewDocumentCommand \__tq_collect_step:w { +m }
  {
    \tl_if_blank:nT {#1} { \__tq_error:n { empty~\iow_char:N\\step. } }
    \seq_gput_right:Nn \g__tq_step_seq {#1}
  }
\NewDocumentCommand \__tq_gobble_choice:w { s O{} +m } { }
\NewDocumentCommand \__tq_gobble_one:w { +m } { }
\NewDocumentCommand \__tq_gobble_note:w { d<> o +m } { }
\NewDocumentCommand \__tq_gobble_label:w { d<> m } { }

\cs_new_protected:Npn \__tq_collect:n #1
  {
    \group_begin:
      \cs_set_eq:NN \choice \__tq_collect_choice:w
      \cs_set_eq:NN \explain \__tq_collect_explain:w
      \cs_set_eq:NN \accept \__tq_collect_accept:w
      \cs_set_eq:NN \step \__tq_collect_step:w
      \cs_set_eq:NN \note \__tq_gobble_note:w
      \cs_set_eq:NN \label \__tq_gobble_label:w
      \vbox_set:Nn \l__tq_tmp_box {#1}
      \dim_compare:nNnT
        { \box_ht:N \l__tq_tmp_box + \box_dp:N \l__tq_tmp_box } > { 0pt }
        {
          \__tq_error:n
            {
              text~outside~\iow_char:N\\choice,~\iow_char:N\\explain,~
              \iow_char:N\\accept,~\iow_char:N\\step,~\iow_char:N\\note~
              or~\iow_char:N\\label~in~the~quiz~body.
            }
        }
    \group_end:
  }
% Inside a generated frame: declarations are no-ops; \note/\label stay active
% unless #1 is false (then they are swallowed, e.g. on the reveal frame).
\cs_new_protected:Npn \__tq_frame_body:nn #1#2
  {
    \cs_set_eq:NN \choice \__tq_gobble_choice:w
    \cs_set_eq:NN \explain \__tq_gobble_one:w
    \cs_set_eq:NN \accept \__tq_gobble_one:w
    \cs_set_eq:NN \step \__tq_gobble_one:w
    \bool_if:nF {#1} { \cs_set_eq:NN \label \__tq_gobble_label:w }
    #2
  }

% ---------------------------------------------------------------- validation
\prg_new_conditional:Npnn \__tq_if_decimal:n #1 { T , F , TF }
  {
    \regex_match:nnTF { \A -? [0-9]+ (\. [0-9]+)? \Z } {#1}
      { \prg_return_true: } { \prg_return_false: }
  }
\cs_generate_variant:Nn \__tq_if_decimal:nF { V }
\cs_new_protected:Npn \__tq_need_count:Nnnn #1#2#3#4
  {
    \bool_lazy_or:nnT
      { \int_compare_p:nNn { \seq_count:N #1 } < {#2} }
      { \int_compare_p:nNn { \seq_count:N #1 } > {#3} }
      { \__tq_error:n { needs~#2--#3~#4~(found~\seq_count:N #1). } }
  }
\cs_new_protected:Npn \__tq_forbid:Nn #1#2
  { \seq_if_empty:NF #1 { \__tq_error:n { #2~not~allowed~for~type~'\g__tq_type_tl'. } } }
\cs_new_protected:Npn \__tq_forbid_tl:Nn #1#2
  { \tl_if_empty:NF #1 { \__tq_error:n { key~'#2'~not~allowed~for~type~'\g__tq_type_tl'. } } }

\cs_new_protected:Npn \__tq_infer_type:
  {
    \int_gzero:N \g__tq_correct_int
    \seq_map_inline:Nn \g__tq_correct_seq { \int_gadd:Nn \g__tq_correct_int {##1} }
    \tl_if_empty:NT \g__tq_type_tl
      {
        \seq_if_empty:NTF \g__tq_step_seq
          {
            \seq_if_empty:NTF \g__tq_accept_seq
              {
                \seq_if_empty:NTF \g__tq_choice_seq
                  {
                    \str_case:VnF \g__tq_answer_tl
                      {
                        { true } { \tl_gset:Nn \g__tq_type_tl { truefalse } }
                        { false } { \tl_gset:Nn \g__tq_type_tl { truefalse } }
                      }
                      {
                        \__tq_if_decimal:VF \g__tq_answer_tl
                          { \__tq_error:n { cannot~infer~the~question~type;~set~type=... } }
                        \tl_gset:Nn \g__tq_type_tl { numeric }
                      }
                  }
                  {
                    \int_case:nnF { \g__tq_correct_int }
                      {
                        { 0 }
                          {
                            \__tq_error:n
                              { mark~a~correct~choice~with~\iow_char:N\\choice*~or~set~type=poll. }
                          }
                        { 1 } { \tl_gset:Nn \g__tq_type_tl { single } }
                      }
                      { \tl_gset:Nn \g__tq_type_tl { multiple } }
                  }
              }
              { \tl_gset:Nn \g__tq_type_tl { text } }
          }
          { \tl_gset:Nn \g__tq_type_tl { order } }
      }
  }

\cs_new_protected:Npn \__tq_validate:
  {
    \str_case:VnF \g__tq_type_tl
      {
        { single }
          {
            \__tq_need_count:Nnnn \g__tq_choice_seq { 2 } { 6 } { choices }
            \int_compare:nNnF { \g__tq_correct_int } = { 1 }
              { \__tq_error:n { type~single~needs~exactly~one~\iow_char:N\\choice*. } }
            \__tq_no_extras:
          }
        { multiple }
          {
            \__tq_need_count:Nnnn \g__tq_choice_seq { 2 } { 6 } { choices }
            \int_compare:nNnT { \g__tq_correct_int } < { 1 }
              { \__tq_error:n { type~multiple~needs~at~least~one~\iow_char:N\\choice*. } }
            \__tq_no_extras:
          }
        { poll }
          {
            \__tq_need_count:Nnnn \g__tq_choice_seq { 2 } { 6 } { choices }
            \int_compare:nNnF { \g__tq_correct_int } = { 0 }
              { \__tq_error:n { a~poll~has~no~correct~choices~(use~\iow_char:N\\choice). } }
            \__tq_no_extras:
            \__tq_force_unscored:
            \tl_if_empty:NT \g__tq_select_tl { \tl_gset:Nn \g__tq_select_tl { single } }
          }
        { truefalse }
          {
            \__tq_forbid:Nn \g__tq_choice_seq { \iow_char:N\\choice }
            \__tq_forbid:Nn \g__tq_accept_seq { \iow_char:N\\accept }
            \__tq_forbid:Nn \g__tq_step_seq { \iow_char:N\\step }
            \str_case:VnF \g__tq_answer_tl
              {
                { true }
                  {
                    \__tq_add_choice:nnn { true } { 1 } { \g__tq_true_tl }
                    \__tq_add_choice:nnn { false } { 0 } { \g__tq_false_tl }
                  }
                { false }
                  {
                    \__tq_add_choice:nnn { true } { 0 } { \g__tq_true_tl }
                    \__tq_add_choice:nnn { false } { 1 } { \g__tq_false_tl }
                  }
              }
              { \__tq_error:n { type~truefalse~needs~answer=true~or~answer=false. } }
            \int_gset:Nn \g__tq_correct_int { 1 }
          }
        { numeric }
          {
            \__tq_forbid:Nn \g__tq_choice_seq { \iow_char:N\\choice }
            \__tq_forbid:Nn \g__tq_accept_seq { \iow_char:N\\accept }
            \__tq_forbid:Nn \g__tq_step_seq { \iow_char:N\\step }
            \tl_if_empty:NTF \g__tq_answer_tl
              { \__tq_force_unscored: }
              { \__tq_check_decimal:Nn \g__tq_answer_tl { answer } }
            \__tq_check_decimal:Nn \g__tq_tolerance_tl { tolerance }
            \tl_if_empty:NF \g__tq_min_tl { \__tq_check_decimal:Nn \g__tq_min_tl { min } }
            \tl_if_empty:NF \g__tq_max_tl { \__tq_check_decimal:Nn \g__tq_max_tl { max } }
            \tl_if_empty:NF \g__tq_step_tl { \__tq_check_decimal:Nn \g__tq_step_tl { step } }
            \__tq_check_numeric_range:
          }
        { text }
          {
            \__tq_forbid:Nn \g__tq_choice_seq { \iow_char:N\\choice }
            \__tq_forbid:Nn \g__tq_step_seq { \iow_char:N\\step }
            \seq_if_empty:NT \g__tq_accept_seq
              { \__tq_error:n { type~text~needs~at~least~one~\iow_char:N\\accept. } }
          }
        { open }
          {
            \__tq_forbid:Nn \g__tq_choice_seq { \iow_char:N\\choice }
            \__tq_forbid:Nn \g__tq_accept_seq { \iow_char:N\\accept }
            \__tq_forbid:Nn \g__tq_step_seq { \iow_char:N\\step }
            \__tq_force_unscored:
            \tl_if_empty:NT \g__tq_display_tl { \tl_gset:Nn \g__tq_display_tl { wordcloud } }
          }
        { sketch }
          {
            \__tq_forbid:Nn \g__tq_choice_seq { \iow_char:N\\choice }
            \__tq_forbid:Nn \g__tq_accept_seq { \iow_char:N\\accept }
            \__tq_forbid:Nn \g__tq_step_seq { \iow_char:N\\step }
            \__tq_forbid_tl:Nn \g__tq_answer_tl { answer }
            \__tq_force_unscored:
          }
        { order }
          {
            \__tq_forbid:Nn \g__tq_choice_seq { \iow_char:N\\choice }
            \__tq_forbid:Nn \g__tq_accept_seq { \iow_char:N\\accept }
            \__tq_need_count:Nnnn \g__tq_step_seq { 2 } { 6 } { steps }
          }
      }
      { \__tq_error:n { unknown~type~'\g__tq_type_tl'. } }
    \str_if_eq:VnF \g__tq_type_tl { poll } { \__tq_forbid_tl:Nn \g__tq_select_tl { select } }
    \str_if_eq:VnF \g__tq_type_tl { open } { \__tq_forbid_tl:Nn \g__tq_display_tl { display } }
    \tl_if_empty:NT \g__tq_points_tl
      { \tl_gset_eq:NN \g__tq_points_tl \g__tq_default_points_tl }
    \tl_if_empty:NT \g__tq_leaderboard_tl
      {
        \bool_lazy_and:nnTF
          { \g__tq_default_leaderboard_bool }
          { ! \str_if_eq_p:Vn \g__tq_points_tl { none } }
          { \tl_gset:Nn \g__tq_leaderboard_tl { true } }
          { \tl_gset:Nn \g__tq_leaderboard_tl { false } }
      }
    \tl_if_empty:NT \g__tq_shuffle_tl
      {
        \bool_if:NTF \g__tq_default_shuffle_bool
          { \tl_gset:Nn \g__tq_shuffle_tl { true } }
          { \tl_gset:Nn \g__tq_shuffle_tl { false } }
      }
    % cols = 0 means automatic, decided by \__tq_auto_cols: in the first frame
  }
\cs_new_protected:Npn \__tq_no_extras:
  {
    \__tq_forbid:Nn \g__tq_accept_seq { \iow_char:N\\accept }
    \__tq_forbid:Nn \g__tq_step_seq { \iow_char:N\\step }
    \__tq_forbid_tl:Nn \g__tq_answer_tl { answer }
  }
\cs_new_protected:Npn \__tq_force_unscored:
  {
    \tl_if_empty:NF \g__tq_points_tl
      {
        \str_if_eq:VnF \g__tq_points_tl { none }
          { \__tq_error:n { type~'\g__tq_type_tl'~(or~a~numeric~question~without~answer)~is~not~scored. } }
      }
    \tl_gset:Nn \g__tq_points_tl { none }
  }
\cs_new_protected:Npn \__tq_check_decimal:Nn #1#2
  { \__tq_if_decimal:VF #1 { \__tq_error:n { #2~must~be~a~decimal~number. } } }
\cs_new_protected:Npn \__tq_check_numeric_range:
  {
    \fp_compare:nNnT { \g__tq_tolerance_tl } < { 0 }
      { \__tq_error:n { tolerance~must~not~be~negative. } }
    \tl_if_empty:NF \g__tq_step_tl
      {
        \fp_compare:nNnF { \g__tq_step_tl } > { 0 }
          { \__tq_error:n { step~must~be~positive. } }
      }
    \tl_if_empty:NF \g__tq_min_tl
      {
        \tl_if_empty:NF \g__tq_max_tl
          {
            \fp_compare:nNnT { \g__tq_min_tl } > { \g__tq_max_tl }
              { \__tq_error:n { min~must~not~exceed~max. } }
          }
      }
    % An unscored estimate has no answer. A scored numeric question must allow
    % at least one value in its answer +/- tolerance interval within the bounds.
    \tl_if_empty:NF \g__tq_answer_tl
      {
        \tl_if_empty:NF \g__tq_min_tl
          {
            \fp_compare:nNnT { \g__tq_answer_tl + \g__tq_tolerance_tl } < { \g__tq_min_tl }
              { \__tq_error:n { no~correct~answer~lies~within~the~numeric~bounds. } }
          }
        \tl_if_empty:NF \g__tq_max_tl
          {
            \fp_compare:nNnT { \g__tq_answer_tl - \g__tq_tolerance_tl } > { \g__tq_max_tl }
              { \__tq_error:n { no~correct~answer~lies~within~the~numeric~bounds. } }
          }
        % With both bounds the phone uses a slider. Its selectable values start
        % at min, in increments of step (default 1), not at multiples of step.
        \tl_if_empty:NF \g__tq_min_tl
          {
            \tl_if_empty:NF \g__tq_max_tl
              {
                \fp_set:Nn \l__tq_numeric_step_fp { 1 }
                \tl_if_empty:NF \g__tq_step_tl
                  { \fp_set:Nn \l__tq_numeric_step_fp { \g__tq_step_tl } }
                \fp_compare:nNnT
                  {
                    \g__tq_min_tl + \l__tq_numeric_step_fp *
                    ceil( ( max( \g__tq_min_tl, \g__tq_answer_tl - \g__tq_tolerance_tl )
                            - \g__tq_min_tl ) / \l__tq_numeric_step_fp )
                  }
                  > { min( \g__tq_max_tl, \g__tq_answer_tl + \g__tq_tolerance_tl ) }
                  { \__tq_error:n { no~correct~answer~is~selectable~with~these~slider~bounds~and~step. } }
              }
          }
      }
  }
\cs_new_protected:Npn \__tq_add_choice:nnn #1#2#3
  {
    \seq_gput_right:Ne \g__tq_choice_seq { \exp_not:V #3 }
    \seq_gput_right:Nn \g__tq_choice_id_seq {#1}
    \seq_gput_right:Nn \g__tq_correct_seq {#2}
  }

% Display order.  Shuffling is deterministic: authored items are sorted by the
% MD5 of "<quiz id>/<index>", so every build of a quiz shows the same order.
\cs_new_protected:Npn \__tq_permutation:nN #1#2
  {
    \seq_clear:N \l__tq_tmp_seq
    \int_step_inline:nn {#1}
      { \seq_put_right:Ne \l__tq_tmp_seq { \str_mdfive_hash:e { \g__tq_id_tl / ##1 } / ##1 } }
    \seq_sort:Nn \l__tq_tmp_seq
      { \str_compare:eNeTF {##1} > {##2} { \sort_return_swapped: } { \sort_return_same: } }
    \seq_gclear:N #2
    \seq_map_inline:Nn \l__tq_tmp_seq { \seq_gput_right:Ne #2 { \__tq_after_slash:w ##1 \q_stop } }
  }
\cs_new:Npn \__tq_after_slash:w #1 / #2 \q_stop {#2}
\cs_new_protected:Npn \__tq_compute_order:
  {
    \str_if_eq:VnTF \g__tq_type_tl { order }
      { \int_set:Nn \l__tq_n_int { \seq_count:N \g__tq_step_seq } }
      { \int_set:Nn \l__tq_n_int { \seq_count:N \g__tq_choice_seq } }
    \bool_lazy_or:nnTF
      { \str_if_eq_p:Vn \g__tq_type_tl { order } }
      { \str_if_eq_p:Vn \g__tq_shuffle_tl { true } }
      {
        \__tq_permutation:nN { \l__tq_n_int } \g__tq_order_seq
        % an ordering question must never be shown in its solved order
        \str_if_eq:VnT \g__tq_type_tl { order }
          {
            \str_if_eq:eeT
              { \seq_use:Nn \g__tq_order_seq { , } }
              { \int_step_function:nN { \l__tq_n_int } \__tq_comma_item:n }
              {
                \seq_gpop_left:NN \g__tq_order_seq \l__tq_tmp_tl
                \seq_gput_right:NV \g__tq_order_seq \l__tq_tmp_tl
              }
          }
      }
      {
        \seq_gclear:N \g__tq_order_seq
        \int_step_inline:nn { \l__tq_n_int } { \seq_gput_right:Nn \g__tq_order_seq {##1} }
      }
    \seq_gclear:N \g__tq_shape_seq
    \str_if_eq:VnTF \g__tq_type_tl { truefalse }
      { \seq_gput_right:Nn \g__tq_shape_seq { 2 } \seq_gput_right:Nn \g__tq_shape_seq { 1 } }
      { \int_step_inline:nn { \l__tq_n_int } { \seq_gput_right:Nn \g__tq_shape_seq {##1} } }
    \prop_gclear:N \g__tq_item_shape_prop
    \int_step_inline:nn { \l__tq_n_int }
      {
        \prop_gput:Nee \g__tq_item_shape_prop
          { \seq_item:Nn \g__tq_order_seq {##1} } { \seq_item:Nn \g__tq_shape_seq {##1} }
      }
  }
\prop_new:N \g__tq_item_shape_prop
\cs_new:Npn \__tq_comma_item:n #1 { \int_compare:nNnF {#1} = { 1 } { , } #1 }

% ---------------------------------------------------------------- export (present)
% The quiz's records (Q P C S L A E N O; build/tqz.py), on the first slide of its frame.
\cs_new_protected:Npn \__tq_export:
  {
    \__tq_emit:n
      {
        Q | \g__tq_id_tl | \g__tq_type_tl | \int_use:N \g__tq_time_int
          | \g__tq_points_tl | \g__tq_leaderboard_tl | \g__tq_shuffle_tl
          | \g__tq_select_tl | \bool_if:NTF \g__tq_partial_bool { true } { false }
          | \int_use:N \g__tq_cols_int
          | \__tq_hex:V \g__tq_title_tl
          | \__tq_hex:e { \CurrentFilePath / \CurrentFile }
          | \int_use:N \tex_inputlineno:D
          | \g__tq_reveal_tl
      }
    \__tq_emit:n { P | \g__tq_id_tl | \__tq_hex:V \g__tq_prompt_tl }
    \int_zero:N \l__tq_n_int
    \seq_map_inline:Nn \g__tq_choice_seq
      {
        \int_incr:N \l__tq_n_int
        \__tq_emit:n
          {
            C | \g__tq_id_tl | \int_use:N \l__tq_n_int
              | \seq_item:Nn \g__tq_choice_id_seq { \l__tq_n_int }
              | \seq_item:Nn \g__tq_correct_seq { \l__tq_n_int }
              | \__tq_hex:n {##1}
          }
      }
    \int_zero:N \l__tq_n_int
    \seq_map_inline:Nn \g__tq_step_seq
      {
        \int_incr:N \l__tq_n_int
        \__tq_emit:n { S | \g__tq_id_tl | \int_use:N \l__tq_n_int | \__tq_hex:n {##1} }
      }
    \__tq_emit:n
      {
        L | \g__tq_id_tl | \seq_use:Nn \g__tq_order_seq { , }
          | \seq_use:Nn \g__tq_shape_seq { , }
      }
    \seq_map_inline:Nn \g__tq_accept_hex_seq
      { \__tq_emit:n { A | \g__tq_id_tl | ##1 } }
    \bool_if:NT \g__tq_explain_bool
      { \__tq_emit:n { E | \g__tq_id_tl | \__tq_hex:V \g__tq_explain_tl } }
    \str_if_eq:VnT \g__tq_type_tl { numeric }
      {
        \__tq_emit:n
          {
            N | \g__tq_id_tl | \g__tq_answer_tl | \g__tq_tolerance_tl
              | \g__tq_min_tl | \g__tq_max_tl | \g__tq_step_tl
              | \__tq_hex:V \g__tq_unit_tl
          }
      }
    \str_if_eq:VnT \g__tq_type_tl { open }
      { \__tq_emit:n { O | \g__tq_id_tl | \g__tq_display_tl | \int_use:N \g__tq_maxchars_int } }
  }

% ---------------------------------------------------------------- phone assets
% Typeset while the question frame is processed (same fonts and macros as the
% slide), kept in global boxes, shipped after the last slide as pages of
% exactly the asset's size with a transparent background.
\dim_const:Nn \c__tq_phone_prompt_dim { 7cm }
\dim_const:Nn \c__tq_phone_choice_dim { 5.4cm }
\cs_new_protected:Npn \__tq_asset:nnn #1#2#3 % key, width, content
  {
    \texstage_asset_box:nn {#2} {#3}
    % an unbreakable line sticks out of the box: widen the page, never clip
    \__tq_measure:nn {#2} { \normalfont \normalsize #3 }
    \texstage_asset_add:nnn { \g__tq_id_tl } {#1} { \dim_use:N \l__tq_natural_dim }
  }
\cs_new_protected:Npn \__tq_make_assets:
  {
    \__tq_asset:nnn { prompt } { \c__tq_phone_prompt_dim } { \g__tq_prompt_tl }
    \int_zero:N \l__tq_n_int
    \seq_map_inline:Nn \g__tq_choice_seq
      {
        \int_incr:N \l__tq_n_int
        \__tq_asset:nnn
          { choice- \seq_item:Nn \g__tq_choice_id_seq { \l__tq_n_int } }
          { \c__tq_phone_choice_dim } {##1}
      }
    \int_zero:N \l__tq_n_int
    \seq_map_inline:Nn \g__tq_step_seq
      {
        \int_incr:N \l__tq_n_int
        \__tq_asset:nnn { step- \int_use:N \l__tq_n_int } { \c__tq_phone_choice_dim } {##1}
      }
  }
% ---------------------------------------------------------------- layout
% Beamer ends [t] frames with \vfill; filll-order glue wins over it, so our
% fills really push the answer grid / live area down to the bottom (\__tq_vfill:,
% texstage.sty's).
\dim_const:Nn \c__tq_timer_dim { 1.6cm }
\dim_const:Nn \c__tq_gap_dim { 0.22cm }

% #1 = read | question | reveal | solution, #2 = frame | inline
%   frame:  question (and a reserved timer square) at the top, answers at the
%           bottom of the slide, explanation on reveal/solution pages
%   inline: question and answers where the quiz stands in the author's frame;
%           no timer square (the add-in puts the timer in the corner); the
%           explanation below the answers on reveal/solution pages - except with
%           reveal=none, where the course explains on its answer frame
%   read:   the question page with the answers' room left empty (present mode,
%           the page before the question page: the class reads the question,
%           the lecturer's click shows the answers and starts the round)
