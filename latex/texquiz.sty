    title .tl_gset:N = \g__tq_default_title_tl ,
    join-title .tl_gset:N = \g__tq_join_title_tl ,
    join-url .tl_gset:N = \g__tq_join_url_tl ,
    join-text .tl_gset:N = \g__tq_join_text_tl ,
    leaderboard-title .tl_gset:N = \g__tq_leaderboard_title_tl ,
