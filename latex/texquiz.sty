\cs_new_protected:Npn \__tq_set_time:Nn #1#2
  {
    \regex_match:nnTF { \A [0-9]{1,3} \Z } {#2}
      {
        \int_compare:nNnTF {#2} < { 5 } { \__tq_general_error:n { time~must~be~5--240~seconds. } }
          {
            \int_compare:nNnTF {#2} > { 240 }
              { \__tq_general_error:n { time~must~be~5--240~seconds. } }
              { \int_gset:Nn #1 {#2} }
          }
      }
      { \__tq_general_error:n { time~must~be~an~integer~5--240. } }
  }
\cs_new_protected:Npn \__tq_check_points:n #1
  {
    \str_case:nnF {#1} { { standard } { } { double } { } { none } { } }
      { \__tq_general_error:n { points~must~be~standard,~double~or~none. } }
  }
\keys_define:nn { texquiz / setup }
