%% texquiz.sty -- Kahoot-style live quizzes authored in Beamer decks: the quiz of
%% texstage, built on its core, texstage.sty (the mode, the records, the log marks, the
%% extra pages - docs/content-types-design.md, section 4.3).
%%
%% Three output modes, selected by defining \texquizmode before \documentclass
%% (e.g. pdflatex "\def\texquizmode{present}\input{deck}"):
%%   handout   (default) one placeholder page per quiz and per answer frame
%%             (\begin{frame}[answer]), no question, no answers
%%   solutions one page per quiz: question, correct answers marked, explanation;
%%             answer frames as written.  Default when Beamer shows notes, so
%%             the lecturer's notes PDF keeps the answers.
%%   present   reading page (the question, no answers yet), question page,
%%             reveal page, leaderboard frame; writes \jobname.tqz
%%             (metadata, page records, rectangles) and ships phone images as
%%             extra pages after the last slide.  Used by `texquiz build` only.
%% The look is set by \texquizprompt, \texquizchoice, ... (see "theme hooks");
%% texquiz-theme-dbis.sty is the look of the DBIS lectures.
%% See docs/design.md, section 3, and docs/authoring.md.
\NeedsTeXFormat{LaTeX2e}[2023-06-01]
\ProvidesExplPackage{texquiz}{2026-10-01}{0.1.0}{Live quizzes for Beamer decks}
\RequirePackage{tikz}
\RequirePackage{pdftexcmds}
\IfFileExists{qrcode.sty}{\RequirePackage{qrcode}}{}
% the core, texstage.sty: from this folder, or by name if loaded through TEXINPUTS
\tl_set:Ne \l_tmpa_tl { \CurrentFilePath }
\tl_if_empty:NTF \l_tmpa_tl
  { \RequirePackage { texstage } }
  { \exp_args:Ne \RequirePackage { \l_tmpa_tl / texstage } }

