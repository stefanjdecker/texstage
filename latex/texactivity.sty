% The box's words, for a theme to change (\renewcommand); by default the deck's language's.
\providecommand\texactivitylabel{\texstage@text{texactivity}{label}}
\providecommand\texactivityreferencelabel{\texstage@text{texactivity}{reference}}

% A choice's options in the box: the answers' colours and shapes, as texquiz.sty draws them (a theme's
% colours stay) and as the phones show them (web/shared/shapes.js) - 1 red triangle, 2 blue diamond,
% 3 yellow circle, 4 green square, 5 purple star, 6 teal hexagon, then again from the first.
\@ifundefinedcolor{texquiz-1}{\definecolor{texquiz-1}{HTML}{E21B3C}}{}
\@ifundefinedcolor{texquiz-2}{\definecolor{texquiz-2}{HTML}{1368CE}}{}
\@ifundefinedcolor{texquiz-3}{\definecolor{texquiz-3}{HTML}{D89E00}}{}
\@ifundefinedcolor{texquiz-4}{\definecolor{texquiz-4}{HTML}{26890C}}{}
\@ifundefinedcolor{texquiz-5}{\definecolor{texquiz-5}{HTML}{864CBF}}{}
\@ifundefinedcolor{texquiz-6}{\definecolor{texquiz-6}{HTML}{0AA3A3}}{}
\@ifundefined{texquiz@shape}{%      (texquiz.sty's: filled shape n of radius r, centred at the origin)
\def\texquiz@shape#1#2{%
  \ifcase#1\relax
  \or \fill (90:#2) -- (210:#2) -- (330:#2) -- cycle;
  \or \fill (90:#2) -- (180:#2) -- (270:#2) -- (0:#2) -- cycle;
  \or \fill (0,0) circle ({0.8*#2});
  \or \fill ({-0.72*#2},{-0.72*#2}) rectangle ({0.72*#2},{0.72*#2});
  \or \fill (90:#2) -- (126:{0.42*#2}) -- (162:#2) -- (198:{0.42*#2}) -- (234:#2)
        -- (270:{0.42*#2}) -- (306:#2) -- (342:{0.42*#2}) -- (18:#2) -- (54:{0.42*#2}) -- cycle;
  \or \fill (0:#2) -- (60:#2) -- (120:#2) -- (180:#2) -- (240:#2) -- (300:#2) -- cycle;
  \fi}}{}
% \texactivity@lshape{n}: shape n with room for a letter - the phones' (web/shared/shapes.js), in a
% square of side 2 (scaled by the picture)
\def\texactivity@lshape#1{%
  \ifcase#1\relax
  \or \fill (0,0.84) -- (0.88,-0.76) -- (-0.88,-0.76) -- cycle;
  \or \fill (0,0.92) -- (0.92,0) -- (0,-0.92) -- (-0.92,0) -- cycle;
  \or \fill (0,0) circle (0.88);
  \or \fill (-0.76,-0.76) rectangle (0.76,0.76);
  \or \fill (0,0.92) -- (0.22,0.26) -- (0.92,0.26) -- (0.36,-0.16) -- (0.56,-0.84) -- (0,-0.44)
        -- (-0.56,-0.84) -- (-0.36,-0.16) -- (-0.92,0.26) -- (-0.22,0.26) -- cycle;
  \or \fill (-0.46,0.84) -- (0.46,0.84) -- (0.92,0) -- (0.46,-0.84) -- (-0.46,-0.84) -- (-0.92,0) -- cycle;
  \fi}
% \texactivity@badge{n}{letter}: shape n (1 to 6) in its colour, inline - with the letter inside the
% shape where one is given (a choice of seven options or more), larger then, where the phones put it.
\newcommand\texactivity@badge[2]{%
  \ifx\relax#2\relax
    \tikz[baseline=-0.6ex]{%
      \fill[texquiz-#1, rounded corners=1pt] (-0.8ex,-0.8ex) rectangle (0.8ex,0.8ex);
      \begin{scope}[fill=white]\texquiz@shape{#1}{0.58ex}\end{scope}}%
  \else
    \edef\texactivity@scale{\ifcase#1\or0.68\or0.74\or0.86\or0.88\or0.58\or0.86\fi}%
    \edef\texactivity@lift{\ifcase#1\or-0.3\or-0.02\or-0.02\or-0.02\or-0.12\or-0.02\fi}%
    \tikz[baseline=-0.6ex]{%
      \fill[texquiz-#1, rounded corners=1.2pt] (-1.75ex,-1.75ex) rectangle (1.75ex,1.75ex);
      \begin{scope}[fill=white, x=1.65ex, y=1.65ex]\texactivity@lshape{#1}\end{scope}
      \node[inner sep=0pt, text=texquiz-#1, font=\sffamily\bfseries\scriptsize, scale=\texactivity@scale]
        at (0,{\texactivity@lift*1.65ex}) {#2};}%
  \fi}
% \texactivity@option{shape}{letter}{text}: an option in the box - wrapped lines start under its text
\newsavebox\texactivity@badgebox
\newcommand\texactivity@option[3]{%
  \sbox\texactivity@badgebox{\texactivity@badge{#1}{#2}}%
  \hangindent=\dimexpr\wd\texactivity@badgebox+0.35em\relax \hangafter=1
  \noindent\usebox\texactivity@badgebox\hspace{0.35em}#3\par}

