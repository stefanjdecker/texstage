%% texactivity.sty -- a live activity on a Beamer slide: the class builds something together on
%% the phones while the slide shows it grow (docs/live-activities-design.md, section 5).  Built on
%% the core, texstage.sty.
%%
%%   \begin{activity}[id=lecture-graph, input=tuple, fields={Subject, Predicate, Object},
%%                    suggest={:KG, :teaches}, limit=10]
%%     \prompt{Add triples about this lecture: who teaches it, who attends, what it is about.}
%%   \end{activity}
%%
%%   \begin{frame}[t,fragile]{Exercise 2, live}
%%   \begin{activity}[id=prof-lectures, input=code, engine=sparql, seed=data.ttl,
%%                    tokens={SELECT, WHERE, :Professor, ?name, ?title}]
%%     \prompt{For every professor, the titles of the lectures they teach.}
%%     \reference{SELECT ?name ?title WHERE {
%%       ?professor a :Professor ; :name ?name .
%%       ?lecture :taughtBy ?professor ; :title ?title . }}
%%   \end{activity}
%%   \end{frame}
%%
%% The environment stands where its box goes.  Every PDF shows the box with "Live activity" and
%% the prompt; the solutions add the reference queries.  \reference{...} and \seed{...} are read
%% verbatim, so their frame is fragile; reference=FILE and seed=FILE name files beside the deck
%% instead.  In present mode the box, the activity's record and its references go to the .tqz
%% (build/activity.py), and the prompt is typeset for the phones (an extra page, X|activity:<id>):
%%   activity|id|input|engine|fields|suggest|tokens|limit|min|review|open|terms|seed
%%           |reference file|tex file|line
%%   activityref|id|query          activityseed|id|text
%% (texts hex-encoded - in a verbatim text a line ends with "\obeyedline ", as xparse's +v gives
%% it; a list: its items hex-encoded, each followed by a comma).
%% Keys: id (required; lowercase letters, digits, dashes), input=tuple|code (default tuple),
%% width, height (the box; default the line's width, 0.6 of the text height), limit
%% (contributions per student), open=auto|manual (auto: when its frame comes); tuple: fields
%% (two or three; default Subject, Predicate, Object), suggest, min (students a triple needs
%% for the projector), review, terms=exact|loose (default exact: a term as written, as RDF
%% compares IRIs, so :kg and :KG are two nodes; loose: case, accents and spacing do not
%% count, as the word cloud groups answers - for plain words); code: engine (sparql: a Turtle
%% seed; sql: a seed of SQL statements, the queries SQLite's; turtle: the students write a graph
%% in Turtle, a Turtle seed gives the @base and @prefix lines they need not write, a reference is
%% Turtle), tokens (the buttons over the phone's keyboard; \{ \} \# \% \^ for those characters),
%% seed, reference.
%% One id, one activity: it may come again (\againframe) as it was; one activity per frame.
\NeedsTeXFormat{LaTeX2e}[2023-06-01]
\ProvidesExplPackage{texactivity}{2026-10-17}{0.1.0}{A live activity on a Beamer slide (texstage)}
% the core, texstage.sty: from this folder, or by name if loaded through TEXINPUTS
\tl_set:Ne \l_tmpa_tl { \CurrentFilePath }
\tl_if_empty:NTF \l_tmpa_tl
  { \RequirePackage { texstage } }
  { \exp_args:Ne \RequirePackage { \l_tmpa_tl / texstage } }

\msg_new:nnn { texactivity } { general } { Activity~'#1':~#2 }
\tl_new:N \l__ta_id_tl
\tl_new:N \l__ta_input_tl
\tl_new:N \l__ta_engine_tl
\clist_new:N \l__ta_fields_clist
\clist_new:N \l__ta_suggest_clist
\clist_new:N \l__ta_tokens_clist
\tl_new:N \l__ta_limit_tl
\tl_new:N \l__ta_min_tl
\bool_new:N \l__ta_review_bool
\tl_new:N \l__ta_open_tl
\tl_new:N \l__ta_terms_tl
\tl_new:N \l__ta_seed_tl
\tl_new:N \l__ta_reffile_tl
\dim_new:N \l__ta_wd_dim
\dim_new:N \l__ta_ht_dim
\box_new:N \l__ta_box
\box_new:N \l__ta_body_box
\tl_new:N \l__ta_def_tl
\tl_new:N \l__ta_seen_tl
\tl_new:N \l__ta_line_tl
\seq_new:N \l__ta_lines_seq
\bool_new:N \l__ta_new_bool
\tl_new:N \g__ta_prompt_tl              % set by the body's commands (inside a box: globally)
\seq_new:N \g__ta_refs_seq
\str_new:N \g__ta_seedtext_str
\prop_new:N \g__ta_defs_prop            % id -> its definition (keys, prompt, references)
\prop_new:N \g__ta_frames_prop          % a frame's first page -> the activity on it
\ior_new:N \g__ta_ior
\cs_new_protected:Npn \__ta_error:n #1
  { \use:e { \msg_error:nnnn { texactivity } { general } { \l__ta_id_tl } {#1} } }

\keys_define:nn { texactivity }
  {
    id .tl_set:N = \l__ta_id_tl ,
    input .choices:nn = { tuple , code } { \tl_set_eq:NN \l__ta_input_tl \l_keys_choice_tl } ,
    fields .clist_set:N = \l__ta_fields_clist ,
    suggest .clist_set:N = \l__ta_suggest_clist ,
    tokens .clist_set:N = \l__ta_tokens_clist ,
    engine .tl_set:N = \l__ta_engine_tl ,
    seed .tl_set:N = \l__ta_seed_tl ,
    reference .tl_set:N = \l__ta_reffile_tl ,
    limit .tl_set:N = \l__ta_limit_tl ,
    min .tl_set:N = \l__ta_min_tl ,
    review .bool_set:N = \l__ta_review_bool ,
    review .default:n = true ,
    open .choices:nn = { auto , manual } { \tl_set_eq:NN \l__ta_open_tl \l_keys_choice_tl } ,
    terms .choices:nn = { exact , loose } { \tl_set_eq:NN \l__ta_terms_tl \l_keys_choice_tl } ,
    width .dim_set:N = \l__ta_wd_dim ,
    height .dim_set:N = \l__ta_ht_dim ,
    unknown .code:n = \__ta_error:n { unknown~key~'\l_keys_key_str'. }
  }

% The body's commands, \prompt, \reference and \seed: only inside the environment.
\NewDocumentCommand \TexactivityPrompt { +m } { \tl_gset:Nn \g__ta_prompt_tl {#1} }
\NewDocumentCommand \TexactivityReference { +v } { \seq_gput_right:Nn \g__ta_refs_seq {#1} }
\NewDocumentCommand \TexactivitySeed { +v } { \str_gset:Nn \g__ta_seedtext_str {#1} }

\NewDocumentEnvironment { activity } { O{} }
  {
    \__ta_begin:n {#1}
    \vbox_set:Nw \l__ta_body_box          % the body only sets the prompt and the references
  }
  {
    \vbox_set_end:
    \__ta_end:
  }

\cs_new_protected:Npn \__ta_begin:n #1
  {
    \tl_set:Nn \l__ta_input_tl { tuple }
    \tl_set:Nn \l__ta_open_tl { auto }
    \tl_clear:N \l__ta_terms_tl                % (not given: the build's default, exact)
    \clist_set:Nn \l__ta_fields_clist { Subject , Predicate , Object }
    \dim_set:Nn \l__ta_wd_dim { \linewidth }
    \dim_set:Nn \l__ta_ht_dim { 0.6 \textheight }
    \keys_set:nn { texactivity } {#1}
    \tl_gclear:N \g__ta_prompt_tl
    \seq_gclear:N \g__ta_refs_seq
    \str_gclear:N \g__ta_seedtext_str
    \cs_set_eq:NN \prompt \TexactivityPrompt
    \cs_set_eq:NN \reference \TexactivityReference
    \cs_set_eq:NN \seed \TexactivitySeed
  }

\cs_new_protected:Npn \__ta_end:
  {
    \__ta_check:
    \__ta_static_box:
    \texstage_if_mode:nTF { present }
      {
        \texstage_page_record:nnn { activity } { \l__ta_id_tl } { box }
        \par \noindent
        \texstage_rect:nnnnn { \l__ta_id_tl } { box } { box }
          { \box_wd:N \l__ta_box } { \box_ht:N \l__ta_box + \box_dp:N \l__ta_box }
        \box_use:N \l__ta_box
        \par
        \bool_if:NT \l__ta_new_bool { \__ta_record: }
      }
      { \par \noindent \box_use:N \l__ta_box \par }
  }

% The keys that must agree, the id once per activity, one activity per frame.  A frame body is
% typeset once per slide: the record and the phones' picture come with the first.
\cs_new_protected:Npn \__ta_check:
  {
    \tl_if_empty:NT \l__ta_id_tl
      { \__ta_error:n { an~activity~needs~an~id~(id=<lowercase~letters,~digits,~dashes>). } }
    \regex_match:nVF { \A [a-z0-9] [a-z0-9-]{0,62} \Z } \l__ta_id_tl
      { \__ta_error:n { an~id~has~lowercase~letters,~digits~and~dashes. } }
    \str_if_eq:VnTF \l__ta_input_tl { code }
      {
        \tl_if_empty:NT \l__ta_engine_tl
          { \__ta_error:n { input=code~needs~an~engine~(engine=sparql,~engine=sql~or~engine=turtle). } }
      }
      {
        \tl_if_empty:NF \l__ta_engine_tl
          { \__ta_error:n { input=tuple~takes~no~engine~(that~is~for~input=code). } }
      }
    \tl_set:Ne \l__ta_def_tl
      {
        \l__ta_input_tl | \l__ta_engine_tl | \clist_use:Nn \l__ta_fields_clist { , }
        | \clist_use:Nn \l__ta_suggest_clist { , } | \clist_use:Nn \l__ta_tokens_clist { , }
        | \l__ta_limit_tl | \l__ta_min_tl | \bool_if:NTF \l__ta_review_bool { 1 } { 0 }
        | \l__ta_open_tl | \l__ta_terms_tl | \tl_to_str:N \l__ta_seed_tl | \tl_to_str:N \l__ta_reffile_tl
        | \tl_to_str:N \g__ta_prompt_tl | \seq_use:Nn \g__ta_refs_seq { | }
      }
    \bool_set_true:N \l__ta_new_bool
    \prop_get:NVNT \g__ta_defs_prop \l__ta_id_tl \l__ta_seen_tl
      {
        \bool_set_false:N \l__ta_new_bool
        \tl_if_eq:NNF \l__ta_seen_tl \l__ta_def_tl
          { \__ta_error:n { the~id~names~another~activity~-~other~keys,~prompt~or~references. } }
      }
    \prop_gput:NVV \g__ta_defs_prop \l__ta_id_tl \l__ta_def_tl
    \prop_get:NVNTF \g__ta_frames_prop \beamer@framestartpage \l__ta_seen_tl
      {
        \tl_if_eq:NNF \l__ta_seen_tl \l__ta_id_tl
          { \__ta_error:n { a~frame~has~one~activity~-~this~one~has~'\l__ta_seen_tl'~too. } }
      }
      { \prop_gput:NVV \g__ta_frames_prop \beamer@framestartpage \l__ta_id_tl }
  }

% The box in every PDF: "Live activity" and the prompt - the solutions add the references. In
% texstage the activity's picture covers it; PowerPoint and the handout show it as it is.
\cs_new_protected:Npn \__ta_static_box:
  {
    \texstage_vbox_set:Nnn \l__ta_box { \l__ta_wd_dim }
      {
        \hbox:n
          {
            \fboxsep = 5pt
            \fboxrule = 0.4pt
            \fcolorbox { black!25 } { black!3 }
              {
                \parbox [b] [ \dim_eval:n { \l__ta_ht_dim - 2 \fboxsep - 2 \fboxrule } ] [t]
                  { \dim_eval:n { \l__ta_wd_dim - 2 \fboxsep - 2 \fboxrule } }
                  { \__ta_static_content: }
              }
          }
      }
  }
\cs_new_protected:Npn \__ta_static_content:
  {
    \raggedright
    { \footnotesize \bfseries \texactivitylabel \par }
    \tl_if_empty:NF \g__ta_prompt_tl
      { \smallskip { \scriptsize \g__ta_prompt_tl \par } }
    \texstage_if_mode:nT { solutions } { \__ta_static_references: }
  }
\cs_new_protected:Npn \__ta_static_references:
  {
    \bool_lazy_and:nnF { \seq_if_empty_p:N \g__ta_refs_seq } { \tl_if_empty_p:N \l__ta_reffile_tl }
      {
        \medskip
        { \scriptsize \bfseries \texactivityreferencelabel \par }
        \ttfamily \tiny
        \seq_map_inline:Nn \g__ta_refs_seq      % (xparse's +v ends a line with \obeyedline)
          {
            \seq_set_split_keep_spaces:Nnn \l__ta_lines_seq { \obeyedline } {##1}
            \seq_map_function:NN \l__ta_lines_seq \__ta_code_line:n
            \smallskip
          }
        \tl_if_empty:NF \l__ta_reffile_tl
          {
            \exp_args:NNV \ior_open:Nn \g__ta_ior \l__ta_reffile_tl
            \ior_str_map_inline:Nn \g__ta_ior { \__ta_code_line:n {##1} }
            \ior_close:N \g__ta_ior
          }
      }
  }
\cs_new_protected:Npn \__ta_code_line:n #1                % a line of code, its spaces kept
  {
    \tl_set:Nn \l__ta_line_tl {#1}
    \tl_replace_all:Nnn \l__ta_line_tl { ~ } { \nobreakspace }
    \hbox:n { \strut \l__ta_line_tl }
  }

% The activity's records and its picture for the phones (present mode, once).
\cs_new:Npn \__ta_hex_item:n #1 { \texstage_hex:n {#1} , }
\cs_new_protected:Npn \__ta_record:
  {
    \texstage_emit:n
      {
        activity | \l__ta_id_tl | \l__ta_input_tl | \l__ta_engine_tl
          | \clist_map_function:NN \l__ta_fields_clist \__ta_hex_item:n
          | \clist_map_function:NN \l__ta_suggest_clist \__ta_hex_item:n
          | \clist_map_function:NN \l__ta_tokens_clist \__ta_hex_item:n
          | \l__ta_limit_tl | \l__ta_min_tl | \bool_if:NTF \l__ta_review_bool { true } { false }
          | \l__ta_open_tl | \l__ta_terms_tl | \texstage_hex:V \l__ta_seed_tl | \texstage_hex:V \l__ta_reffile_tl
          | \texstage_hex:e { \CurrentFilePath / \CurrentFile }
          | \int_use:N \tex_inputlineno:D
      }
    \seq_map_inline:Nn \g__ta_refs_seq
      { \texstage_emit:n { activityref | \l__ta_id_tl | \texstage_hex:n {##1} } }
    \str_if_empty:NF \g__ta_seedtext_str
      { \texstage_emit:n { activityseed | \l__ta_id_tl | \texstage_hex:V \g__ta_seedtext_str } }
    \tl_if_empty:NF \g__ta_prompt_tl
      { \texstage_asset:nnnn { activity: \l__ta_id_tl } { prompt } { 7cm } { \g__ta_prompt_tl } }
  }
\ExplSyntaxOff

% The box's words, for a theme to change (the DBIS theme: German).
\providecommand\texactivitylabel{Live activity -- on your phones}
\providecommand\texactivityreferencelabel{Reference}

\endinput
