\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{manual}[2026/10/28 Conventional article documentation layout]
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[a4paper,margin=25mm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{booktabs}
\RequirePackage{fvextra}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{placeins}
\RequirePackage{needspace}
\RequirePackage{hyperref}
\RequirePackage{bookmark}
\RequirePackage{microtype}
\RequirePackage{upquote}
\DisableLigatures{encoding=*,family=tt*}
\input{glyphtounicode}
\pdfgentounicode=1

\definecolor{manualPurple}{HTML}{263B58}
\definecolor{manualInk}{gray}{0}
\definecolor{manualMuted}{gray}{0.30}
\definecolor{manualPale}{gray}{0.96}
\setlength{\emergencystretch}{2em}
\setlength{\parskip}{0.3em}
\setlength{\parindent}{1em}
\raggedbottom
\setlist[itemize]{itemsep=2pt,topsep=4pt,parsep=0pt}
\fvset{fontsize=\footnotesize,breaklines=true,breakanywhere=true,
  breakautoindent=false,breakindent=1em,baselinestretch=1,
  frame=single,rulecolor=\color{manualMuted},framesep=5pt}
\setlength{\tabcolsep}{5pt}
\renewcommand{\arraystretch}{1.12}
\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt}
\captionsetup{font=small,labelfont=bf}
\hypersetup{colorlinks=true,linkcolor=manualPurple,urlcolor=manualPurple,bookmarksopen=true}
\setcounter{tocdepth}{1}
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.08}
\renewcommand{\floatpagefraction}{0.65}
\newcommand{\manualsection}[1]{\Needspace{12\baselineskip}\section{#1}}
\newcommand{\manualsubheading}[1]{\Needspace{5\baselineskip}\subsection*{#1}}
\newcommand{\manualcaption}{\small}
\pagestyle{plain}
\endinput
