include LICENSE NOTICE README.md
graft docs
prune docs/history
exclude docs/manual-latex/*.aux docs/manual-latex/*.fdb_latexmk docs/manual-latex/*.fls
exclude docs/manual-latex/*.log docs/manual-latex/*.out docs/manual-latex/*.pdf
exclude docs/manual-latex/*.synctex.gz docs/manual-latex/*.toc
graft examples/demo
prune examples/demo/texquiz-out
graft examples/manual
prune examples/manual/texquiz-out
graft deploy
exclude deploy/.env
graft tests
global-exclude __pycache__ *.py[cod] .env
include provenance/original-NOTICE

include CONTRIBUTING.md SECURITY.md CHANGELOG.md
graft requirements
graft maintenance

graft examples/reference
