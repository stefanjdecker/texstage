include LICENSE NOTICE README.md
graft docs
prune docs/history
exclude docs/manual-latex/*.aux docs/manual-latex/*.fdb_latexmk docs/manual-latex/*.fls
exclude docs/manual-latex/*.log docs/manual-latex/*.out docs/manual-latex/*.pdf
exclude docs/manual-latex/*.synctex.gz docs/manual-latex/*.toc
graft examples/demo
prune examples/demo/texquiz-out
graft examples/manual
prune examples/manual/texquiz-out
graft deploy
exclude deploy/.env
graft tests
# the kinds of live activities: packages of their own, which the tests, the kit and deploy/Dockerfile need
graft kinds
prune kinds/texstage-kinds-sql/build
prune kinds/texstage-kinds-rdf/build
prune kinds/texstage-kinds-sql/src/texstage_kinds_sql.egg-info
prune kinds/texstage-kinds-rdf/src/texstage_kinds_rdf.egg-info
global-exclude __pycache__ *.py[cod] .env
include provenance/original-NOTICE

include CONTRIBUTING.md SECURITY.md CHANGELOG.md
graft requirements
graft maintenance

graft examples/reference
graft examples/showcase
prune examples/showcase/texquiz-out

# Never include private recording-production assets in public archives.
prune docs/media/demo
exclude docs/demonstration.md docs/demonstration-transcript.md
exclude examples/showcase/VIDEO-SCRIPT.md examples/showcase/RECORDING.md
